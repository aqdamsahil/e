rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Secure administrator verification
    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'aqdamsahil@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidPoster(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() >= 2 && data.title.size() <= 120 &&
             data.category is string && data.category.size() >= 2 && data.category.size() <= 50 &&
             data.imageUrl is string && data.imageUrl.size() <= 2048 &&
             data.published is bool &&
             data.downloadCount is number && data.downloadCount >= 0 &&
             (!('description' in data) || (data.description is string && data.description.size() <= 1000));
    }

    function isDownloadIncrementAction() {
      return incoming().diff(existing()).affectedKeys().hasOnly(['downloadCount']) &&
             incoming().downloadCount == existing().downloadCount + 1;
    }

    // Posters collection
    match /posters/{posterId} {
      allow get: if isValidId(posterId) && (isAdmin() || resource.data.published == true);
      allow list: if (isAdmin() || resource.data.published == true);
      allow create: if isValidId(posterId) && isAdmin() && isValidPoster(incoming());
      allow update: if isValidId(posterId) && (
        (isAdmin() && isValidPoster(incoming())) ||
        isDownloadIncrementAction()
      );
      allow delete: if isValidId(posterId) && isAdmin();
    }

    // Categories collection
    match /categories/{categoryId} {
      allow get: if isValidId(categoryId);
      allow list: if true;
      allow write: if isValidId(categoryId) && isAdmin();
    }

    // Admins registry collection
    match /admins/{adminId} {
      allow read, write: if isValidId(adminId) && isAdmin();
    }
  }
}
